# Copia este archivo a .env y cambia los dos secretos antes de desplegar.
# La app rechaza estos valores de ejemplo cuando NODE_ENV=production.

APP_PASSWORD=cambia-esta-clave
SESSION_SECRET=cambia-este-secreto-largo

# Carpeta donde se guarda board.json. En Docker se monta como volumen.
DATA_DIR=./data

HOST=0.0.0.0
PORT=3000

# Déjalo en false si abres el puerto de la app directamente.
# Ponlo en true solo cuando nginx termina HTTPS y reenvía a la app.
TRUST_PROXY=false

# auto: la cookie lleva Secure solo si la petición llega como HTTPS.
# Fuerza true cuando el sitio siempre se abre por HTTPS.
# COOKIE_SECURE=true
