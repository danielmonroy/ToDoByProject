[Unit]
Description=Mapa mental de proyectos y tareas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kanban
Environment=NODE_ENV=production
EnvironmentFile=/opt/kanban/.env
ExecStart=/usr/bin/node server/index.ts
Restart=on-failure
RestartSec=5
User=kanban
Group=kanban
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
